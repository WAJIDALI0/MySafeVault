# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database (Prisma)
# Example Postgres connection string (with PgBouncer/Transaction pooling)
DATABASE_URL="postgres://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Example direct connection string (for migrations)
DIRECT_URL="postgres://postgres.xxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Encryption Key (Must be 32 bytes/64 hex characters for AES-256-GCM)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-32-byte-encryption-key-here
