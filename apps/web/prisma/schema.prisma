generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id                   String               @id @db.Uuid
  full_name            String?
  avatar               String?
  timezone             String?              @default("UTC")
  language             String?              @default("en")
  theme                String?              @default("system")
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  logs                 ActivityLog[]
  notifications        Notification[]
  preferences          UserPreference?
  vault_items          VaultItem[]
  webauthn_credentials WebAuthnCredential[]

  @@map("profiles")
}

model VaultItem {
  id             String        @id @default(uuid()) @db.Uuid
  profile_id     String        @db.Uuid
  type           VaultItemType
  title          String
  description    String?
  is_favorite    Boolean       @default(false)
  encrypted_data String
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  /// SECURITY: Only non-sensitive data (e.g. expiration dates, file sizes, tags, password strength metrics) is allowed here.
  /// FORBIDDEN: passwords, hashes, secure note contents, identities, documents, keys, tokens, or any sensitive plaintext.
  metadata       Json?         @default("{}")
  profile        Profile       @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("vault_items")
}

model UserPreference {
  id                    String   @id @default(uuid()) @db.Uuid
  profile_id            String   @unique @db.Uuid
  notification_settings Json     @default("{}")
  security_settings     Json     @default("{}")
  appearance            Json     @default("{}")
  storage_settings      Json     @default("{}")
  created_at            DateTime @default(now())
  updated_at            DateTime @updatedAt
  profile               Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

model ActivityLog {
  id         String   @id @default(uuid()) @db.Uuid
  profile_id String   @db.Uuid
  action     String
  metadata   Json     @default("{}")
  created_at DateTime @default(now())
  profile    Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("activity_logs")
}

model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  profile_id String    @db.Uuid
  type       String
  title      String
  message    String
  is_read    Boolean   @default(false)
  action_url String?
  metadata   Json      @default("{}")
  created_at DateTime  @default(now())
  read_at    DateTime?
  profile    Profile   @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id, is_read])
  @@map("notifications")
}

model WebAuthnCredential {
  id            String   @id @default(uuid()) @db.Uuid
  profile_id    String   @db.Uuid
  credential_id String   @unique
  public_key    Bytes
  counter       BigInt
  device_type   String
  backed_up     Boolean
  transports    String?
  created_at    DateTime @default(now())
  last_used_at  DateTime @default(now())
  profile       Profile  @relation(fields: [profile_id], references: [id], onDelete: Cascade)

  @@index([profile_id])
  @@map("webauthn_credentials")
}

enum VaultItemType {
  PASSWORD
  DOCUMENT
  SECURE_NOTE
  IDENTITY
  RECEIPT
  WARRANTY
}
