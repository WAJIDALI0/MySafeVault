{
  "name": "mysafevault-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm --filter web build",
    "build:turbo": "turbo run build",
    "dev": "pnpm --filter web dev",
    "dev:https": "pnpm --filter web dev:https",
    "dev:turbo": "turbo run dev --ui=stream",
    "lint": "turbo run lint",
    "prepare": "husky",
    "postinstall": "npx prisma@6.19.3 generate --schema=apps/web/prisma/schema.prisma"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@sentry/cli",
      "sharp",
      "@scarf/scarf",
      "@tree-sitter-grammars/tree-sitter-yaml",
      "core-js-pure",
      "tree-sitter-json",
      "tree-sitter"
    ]
  }
}
